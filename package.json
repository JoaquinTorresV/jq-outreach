{
  "name": "jq-outreach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema de prospección por WhatsApp (Baileys): importación, seguimientos automáticos, multi-número, dashboard.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "next dev -p 3000",
    "build": "next build",
    "start": "npm run start:web",
    "start:web": "tsx scripts/migrate.ts && next start -p ${PORT:-3000} -H 0.0.0.0",
    "start:worker": "tsx worker/index.ts",
    "dev:worker": "tsx watch worker/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "exceljs": "^4.4.0",
    "https-proxy-agent": "^9.1.0",
    "libphonenumber-js": "^1.13.16",
    "next": "^16.4.6",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socks-proxy-agent": "^10.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
