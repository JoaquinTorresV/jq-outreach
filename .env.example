# ───────── Obligatorias ─────────
# Postgres (en Easypanel: crea un servicio Postgres y copia su "Internal connection string")
DATABASE_URL=postgres://postgres:CAMBIAME@postgres:5432/jqoutreach

# Contraseña para entrar al dashboard (usa algo largo) y secreto para firmar la cookie
DASHBOARD_PASSWORD=cambia-esta-contraseña-larga
SESSION_SECRET=genera-con-openssl-rand-hex-32

# ───────── Opcionales ─────────
# País por defecto para normalizar números sin prefijo (CL = Chile, CO = Colombia)
DEFAULT_COUNTRY=CL
# Otros países que se prueban si el número no es válido en el país por defecto (separados por coma)
EXTRA_COUNTRIES=CO

# Si es "true", el worker se niega a conectar cuentas sin proxy (evita salir por la IP del VPS)
REQUIRE_PROXY=false

# Webhook de alertas (Discord o Slack). También se puede configurar desde el dashboard > Ajustes
ALERT_WEBHOOK_URL=

# Si quieres que Claude reescriba levemente cada mensaje (anti-ban). Se activa en Ajustes.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Solo si usas SSL con tu Postgres externo
DATABASE_SSL=false

# Para correr un worker por número (uno por servicio en Easypanel): ids de cuentas separados por coma
WORKER_ACCOUNT_IDS=
LOG_LEVEL=info
